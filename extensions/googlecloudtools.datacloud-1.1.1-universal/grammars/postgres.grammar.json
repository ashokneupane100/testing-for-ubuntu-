{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PostgreSQL",
  "scopeName": "source.postgres",
  "patterns": [
    { "include": "#dollar-quoted-string" },
    { "include": "#postgres-operators" },
    { "include": "#postgres-keywords" },
    { "include": "#postgres-datatypes" },
    { "include": "#postgres-functions" },
    { "include": "source.sql" }
  ],
  "repository": {
    "dollar-quoted-string": {
      "name": "string.quoted.other.dollar.postgres",
      "begin": "(\\$[a-zA-Z_0-9]*\\$)",
      "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.postgres" } },
      "end": "\\1",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.postgres" } }
    },
    "postgres-operators": {
      "patterns": [
        { "name": "keyword.operator.cast.postgres", "match": "::" },
        { "name": "keyword.operator.json.postgres", "match": "->>?|#>>?|@>|<@|\\?\\||\\?&|\\?|#-" },
        { "name": "keyword.operator.comparison.postgres", "match": "(?i:\\b(ilike|not\\s+ilike|similar\\s+to)\\b)" }
      ]
    },
    "postgres-keywords": {
      "patterns": [
        { "name": "keyword.other.postgres", "match": "(?i:\\b(vacuum|analyze|explain|listen|notify|unlisten|copy|returning|on\\s+conflict|do\\s+update|do\\s+nothing|distinct\\s+on|window)\\b)" }
      ]
    },
    "postgres-datatypes": {
      "patterns": [
        { "name": "storage.type.postgres", "match": "(?i:\\b(uuid|jsonb?|bytea|inet|cidr|macaddr8?|text|serial[248]?|bigserial|smallserial|timestamptz|timetz|interval|int[48]range|numrange|tstz?range|daterange)\\b)" }
      ]
    },
    "postgres-functions": {
      "patterns": [
        { "name": "support.function.postgres", "match": "(?i:\\b(coalesce|nullif|regexp_(replace|match|matches|split_to_table|split_to_array)|format|concat(_ws)?|jsonb?_(build_object|to_recordset|array_elements|extract_path|set)|date_trunc|age|clock_timestamp|statement_timestamp|now|current_setting|set_config|row_number|rank|dense_rank|lead|lag|first_value|last_value|nth_value)\\b)" }
      ]
    }
  }
}
